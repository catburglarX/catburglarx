# Read-only token used at build time to fetch the GitHub contribution calendar.
# In GitHub Actions the built-in GITHUB_TOKEN is used, so nothing needs setting there.
# Locally, a classic token with no scopes is enough. Without it the section shows a fallback.
GITHUB_TOKEN=

# Leave unset for GitHub Pages (/catburglarx). Set to an empty string for a custom domain.
# NEXT_PUBLIC_BASE_PATH=
